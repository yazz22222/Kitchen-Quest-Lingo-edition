dow type=\\\"logic_boolean\\\"><field name=\\\"BOOL\\\">TRUE</field></shadow><block type=\\\"logic_compare\\\"><field name=\\\"OP\\\">LT</field><value name=\\\"A\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">0</field></shadow><block type=\\\"variables_get\\\"><field name=\\\"VAR\\\" id=\\\"WRvH!rD|!5a`TZQW=QMf\\\">question</field></block></value><value name=\\\"B\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">10</field></shadow></value></block></value><statement name=\\\"DO0\\\"><block type=\\\"function_call\\\"><mutation name=\\\"newQuestion\\\" functionid=\\\"rq;CaM6{_pCx?x{fFeV:\\\"></mutation></block></statement><statement name=\\\"ELSE\\\"><block type=\\\"variables_set\\\"><field name=\\\"VAR\\\" id=\\\"szu.{|-p+Ln[^*+:Y!3R\\\">quizPhase</field><value name=\\\"VALUE\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">0</field></shadow><block type=\\\"text\\\"><field name=\\\"TEXT\\\">results</field></block></value><next><block type=\\\"function_call\\\"><mutation name=\\\"setMode\\\" functionid=\\\"?!8K)#i$J~qLgiXGE_;#\\\"><arg name=\\\"newMode\\\" id=\\\"pnqduqb2hslvsp2lmlq8\\\" type=\\\"string\\\"></arg></mutation><value name=\\\"pnqduqb2hslvsp2lmlq8\\\"><shadow type=\\\"text\\\"><field name=\\\"TEXT\\\">quiz</field></shadow></value><next><block type=\\\"variables_set\\\"><field name=\\\"VAR\\\" id=\\\"!EXvGgfKvsa8B)v4`TBM\\\">quizBest</field><value name=\\\"VALUE\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">0</field></shadow><block type=\\\"math_op2\\\"><field name=\\\"op\\\">max</field><value name=\\\"x\\\"><block type=\\\"variables_get\\\"><field name=\\\"VAR\\\" id=\\\"!EXvGgfKvsa8B)v4`TBM\\\">quizBest</field></block></value><value name=\\\"y\\\"><block type=\\\"variables_get\\\"><field name=\\\"VAR\\\" id=\\\"n%itB9s2QjQ$.Fzts363\\\">score</field></block></value></block></value><next><block type=\\\"music_playable_play\\\"><field name=\\\"playbackMode\\\">music.PlaybackMode.InBackground</field><value name=\\\"toPlay\\\"><shadow type=\\\"music_melody_playable\\\"><field name=\\\"melody\\\">music.baDing</field></shadow><block type=\\\"music_string_playable\\\"><value name=\\\"melody\\\"><shadow type=\\\"melody_editor\\\"><field name=\\\"melody\\\">\\\"C5 E5 G5 C6 G5 C6 E6 - \\\"</field></shadow></value><value name=\\\"tempo\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"40\\\" max=\\\"500\\\" label=\\\"Tempo\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">420</field></shadow></value></block></value></block></next></block></next></block></next></block></statement></block></next></block></next></block></statement></block></next></block></next></block></statement></block></xml>\",\n  \"main.ts\": \"namespace SpriteKind {\\n    export const Decor = SpriteKind.create()\\n}\\n// A short beep that slides from one pitch to another\\nfunction blip (fromHz: number, toHz: number, ms: number) {\\n    music.play(music.createSoundEffect(\\n    WaveShape.Square,\\n    fromHz,\\n    toHz,\\n    80,\\n    0,\\n    ms,\\n    SoundExpressionEffect.None,\\n    InterpolationCurve.Linear\\n    ), music.PlaybackMode.InBackground)\\n}\\n// How long the current screen has been open (in milliseconds)\\nfunction elapsed () {\\n    return game.runtime() - modeStart\\n}\\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\\n    pressed = \\\"B\\\"\\n})\\n// The pause menu\\nfunction menuScreen () {\\n    dim(2)\\n    panel(26, 22, 108, 68, 8, 15)\\n    canvas.printTextCentered(\\\"MENU\\\", 27, 5, TextSize.Normal)\\n    i = 0\\n    while (i < 3) {\\n        k = 1\\n        if (i == menuChoice) {\\n            k = 5\\n            panel(30, 37 + i * 14, 100, 13, 10, 15)\\n            drawPicture(22, 33 + bob(600, 1), 40 + i * 14)\\n        }\\n        text = \\\"Continue|Word Book|Challenge\\\".split(\\\"|\\\")[i]\\n        canvas.printText(text, 41, 40 + i * 14, k, TextSize.Normal)\\n        i += 1\\n    }\\n    hint(\\\"A\\\", 29, 93, \\\"Choose\\\", 1)\\n    hint(\\\"B\\\", 89, 93, \\\"Close\\\", 1)\\n    // Going past the first or last option wraps round to the other end\\n    if (pressed == \\\"up\\\") {\\n        menuChoice = (menuChoice + 2) % 3\\n        blip(880, 880, 25)\\n    } else if (pressed == \\\"down\\\") {\\n        menuChoice = (menuChoice + 1) % 3\\n        blip(880, 880, 25)\\n    } else if (pressed == \\\"B\\\" || pressed == \\\"A\\\" && menuChoice == 0) {\\n        blip(620, 240, 130)\\n        setMode(\\\"explore\\\")\\n    } else if (pressed == \\\"A\\\" && menuChoice == 1) {\\n        blip(660, 990, 70)\\n        setMode(\\\"book\\\")\\n    } else if (pressed == \\\"A\\\") {\\n        blip(660, 990, 70)\\n        backTo = \\\"menu\\\"\\n        setMode(\\\"board\\\")\\n    }\\n}\\n// A and B only remember the press. The screen reacts to it in the next frame.\\ncontroller.A.onEvent(ControllerButtonEvent.Pressed, function () {\\n    pressed = \\\"A\\\"\\n})\\n// How to play. A starts the game and B goes back to the title.\\nfunction helpScreen () {\\n    canvas.drawTransparentImage(assets.image`helpCard`, 4, 3)\\n    hint(\\\"A\\\", 44, 103 + bob(1000, 1), \\\"Let's cook!\\\", 2)\\n    if (pressed == \\\"A\\\") {\\n        // Start the game: show the player and let the camera follow them\\n        blip(660, 990, 70)\\n        heroLook.setFlag(SpriteFlag.Invisible, false)\\n        scene.cameraFollowSprite(heroLook)\\n        setMode(\\\"explore\\\")\\n    } else if (pressed == \\\"B\\\") {\\n        blip(700, 420, 80)\\n        setMode(\\\"title\\\")\\n    }\\n}\\n// The word book: the 10 words in two rows of 5\\nfunction bookScreen () {\\n    k = bookChoice\\n    if (pressed == \\\"left\\\" && k % 5 > 0) {\\n        k += -1\\n    } else if (pressed == \\\"right\\\" && k % 5 < 4) {\\n        k += 1\\n    } else if (pressed == \\\"up\\\" || pressed == \\\"down\\\") {\\n        k = (k + 5) % 10\\n    }\\n    if (k != bookChoice) {\\n        bookChoice = k\\n        blip(880, 880, 25)\\n    } else if (pressed == \\\"A\\\" && learned[k]) {\\n        showCard(k, \\\"book\\\")\\n    } else if (pressed == \\\"A\\\") {\\n        blip(210, 160, 140)\\n    } else if (pressed == \\\"B\\\") {\\n        blip(700, 420, 80)\\n        setMode(\\\"menu\\\")\\n    }\\n    canvas.drawTransparentImage(assets.image`bookFrame`, 0, 0)\\n    canvas.printText(\\\"\\\" + foundCount + \\\"/10\\\", 66, 6, 14, TextSize.Normal)\\n    progressBar(7, 15, 146, 5, 7)\\n    i = 0\\n    while (i < 10) {\\n        // Found words show their picture, the others a grey shape and \\\"?\\\"\\n        j = 17 + i % 5 * 26\\n        k = 36 + Math.idiv(i, 5) * 24\\n        if (learned[i]) {\\n            panel(j, k, 22, 18, 6, 13)\\n            drawPicture(i, j + 3, k + 1)\\n        } else {\\n            panel(j, k, 22, 18, 9, 13)\\n            drawPicture(10 + i, j + 3, k + 1)\\n            canvas.printText(\\\"?\\\", j + 8, k + 5, 8, TextSize.Normal)\\n        }\\n        if (i == bookChoice) {\\n            brackets(j - 2, k - 2, 26, 22, 2 + 2 * Math.idiv(game.runtime() % 600, 300))\\n        }\\n        i += 1\\n    }\\n    // Under the grid: the chosen word in Malay and English, or a clue to where it is\\n    if (learned[bookChoice]) {\\n        canvas.printTextCentered(wordPart(bookChoice, 0), 101, 5, TextSize.Normal)\\n        canvas.printTextCentered(wordPart(bookChoice, 1), 110, 1, TextSize.Small)\\n    } else {\\n        canvas.printTextCentered(\\\"???\\\", 101, 9, TextSize.Normal)\\n        canvas.printTextCentered(wordPart(bookChoice, 5), 110, 6, TextSize.Small)\\n    }\\n}\\n// Show the A or B button with a word next to it\\nfunction hint (button: string, hintX: number, hintY: number, label: string, color: number) {\\n    drawPicture(20 + \\\"AB\\\".indexOf(button), hintX, hintY)\\n    canvas.printText(label, hintX + 12, hintY + 1, color, TextSize.Normal)\\n}\\n// The right picture and 2 different wrong ones, in a random order\\nfunction newQuestion () {\\n    choices = []\\n    choices.push(quizOrder[question])\\n    while (choices.length < 3) {\\n        k = randint(0, 9)\\n        if (choices.indexOf(k) < 0) {\\n            choices.insertAt(randint(0, choices.length), k)\\n        }\\n    }\\n    picked = 1\\n    quizPhase = \\\"asking\\\"\\n}\\n// Draw a box with cut corners (fill colour inside, edge colour around it)\\nfunction panel (left: number, top: number, wide: number, tall: number, fill: number, edge: number) {\\n    canvas.fillRect(left + 1, top, wide - 2, tall, edge)\\n    canvas.fillRect(left, top + 1, wide, tall - 2, edge)\\n    canvas.fillRect(left + 1, top + 1, wide - 2, tall - 2, fill)\\n}\\n// The title screen, with the kitchen behind it\\nfunction titleScreen () {\\n    dim(1)\\n    canvas.drawTransparentImage(assets.image`titleArt`, 0, 0)\\n    drawPicture(22, 42 + bob(600, 1), 75 + 13 * menuChoice)\\n    text = \\\"START GAME|HOW TO PLAY\\\".split(\\\"|\\\")[menuChoice]\\n    canvas.printText(text, 50, 75 + 13 * menuChoice, 5, TextSize.Normal)\\n    if (pressed == \\\"up\\\" || pressed == \\\"down\\\") {\\n        menuChoice = 1 - menuChoice\\n        blip(880, 880, 25)\\n    } else if (pressed == \\\"A\\\") {\\n        blip(660, 990, 70)\\n        setMode(\\\"help\\\")\\n    }\\n}\\n// Draw the big Malay word and its syllables (like \\\"ku-a-li\\\"). The syllable being said (lit) is red.\\nfunction drawSyllables () {\\n    lit = -1\\n    if (sayStart >= 0) {\\n        lit = Math.idiv(game.runtime() - sayStart, 450)\\n    }\\n    syllables = wordPart(cardWord, 2)\\n    canvas.printTextCentered(wordPart(cardWord, 0), 57, 8, TextSize.Big)\\n    canvas.printTextCentered(syllables, 76, 8, TextSize.Normal)\\n    // i is the place in the syllables, j the letter in the big word, n the syllable number\\n    i = 0\\n    j = 0\\n    n = 0\\n    while (i < syllables.length) {\\n        text = syllables.charAt(i)\\n        if (text == \\\"-\\\" || text == \\\" \\\") {\\n            n += 1\\n        } else if (n == lit) {\\n            x = 80 - 3 * syllables.length + 6 * i\\n            canvas.fillRect(x - 1, 74, 7, 11, 5)\\n            canvas.printText(text, x, 76, 2, TextSize.Normal)\\n            y = 80 - 6 * wordPart(cardWord, 0).length + 12 * j\\n            canvas.printText(wordPart(cardWord, 0).charAt(j), y, 57, 2, TextSize.Big)\\n        }\\n        if (text != \\\"-\\\") {\\n            j += 1\\n        }\\n        i += 1\\n    }\\n    // Tick once for each syllable, and stop after the last one\\n    if (lit > n) {\\n        sayStart = -1\\n    } else if (lit >= 0 && lit != lastTick) {\\n        lastTick = lit\\n        blip(760, 760, 70)\\n    }\\n}\\n// The word quiz: a Malay word and 3 pictures. quizPhase is \\\"asking\\\", \\\"answered\\\" or \\\"results\\\".\\nfunction quizScreen () {\\n    canvas.drawTransparentImage(assets.image`bgQuiz`, 0, 0)\\n    if (quizPhase == \\\"results\\\") {\\n        canvas.drawTransparentImage(assets.image`quizResults`, 8, 18)\\n        canvas.printTextCentered(\\\"\\\" + score + \\\"/10\\\", 36, 1, TextSize.Big)\\n        // A message in Malay and English that depends on the score\\n        text = \\\"Cuba lagi! (Try again!)\\\"\\n        if (score >= 9) {\\n            text = \\\"Hebat! (Excellent!)\\\"\\n        } else if (score >= 6) {\\n            text = \\\"Bagus! (Good job!)\\\"\\n        }\\n        canvas.printTextCentered(text, 69, 7, TextSize.Normal)\\n        text = \\\"Best score: \\\" + quizBest + \\\"/10\\\"\\n        canvas.printTextCentered(text, 80, 6, TextSize.Normal)\\n        if (elapsed() > 800) {\\n            hint(\\\"B\\\", 62, 94, \\\"Back\\\", 1)\\n        }\\n    } else {\\n        canvas.printText(\\\"Q\\\" + (question + 1) + \\\"/10\\\", 70, 2, 1, TextSize.Normal)\\n        canvas.printText(\\\"Score \\\" + score, 112, 2, 7, TextSize.Normal)\\n        canvas.drawTransparentImage(assets.image`quizCard`, 8, 14)\\n        n = quizOrder[question]\\n        canvas.printTextCentered(wordPart(n, 0), 27, 8, TextSize.Big)\\n        i = 0\\n        while (i < 3) {\\n            // j is the frame colour and k the inside: green for the right answer, red for a wrong pick\\n            j = 15\\n            k = 1\\n            if (quizPhase == \\\"asking\\\" && i == picked) {\\n                j = 5\\n            } else if (quizPhase == \\\"answered\\\" && choices[i] == n) {\\n                j = 7\\n                k = 7\\n            } else if (quizPhase == \\\"answered\\\" && i == picked) {\\n                j = 2\\n                k = 2\\n            }\\n            panel(9 + i * 50, 54, 42, 40, j, 15)\\n            panel(11 + i * 50, 56, 38, 36, k, j)\\n            canvas.fillRect(13 + i * 50, 58, 34, 32, 1)\\n            canvas.drawTransparentImage(bigIcons[choices[i]], 14 + i * 50, 58)\\n            i += 1\\n        }\\n        if (quizPhase == \\\"asking\\\") {\\n            drawPicture(23, 27 + picked * 50, 48 + bob(600, 1))\\n            hint(\\\"A\\\", 32, 104, \\\"Choose\\\", 1)\\n            hint(\\\"B\\\", 92, 104, \\\"Quit\\\", 1)\\n        } else if (choices[picked] == n) {\\n            panel(4, 97, 152, 22, 11, 7)\\n            canvas.printText(\\\"Betul! (Right)\\\", 8, 99, 5, TextSize.Normal)\\n        } else {\\n            panel(4, 97, 152, 22, 12, 2)\\n            canvas.printText(\\\"Salah! (Wrong)\\\", 8, 99, 4, TextSize.Normal)\\n        }\\n        if (quizPhase == \\\"answered\\\") {\\n            text = \\\"\\\" + wordPart(n, 0) + \\\" = \\\" + wordPart(n, 1)\\n            canvas.printTextCentered(text, 109, 1, TextSize.Normal)\\n            if (elapsed() > 500) {\\n                hint(\\\"A\\\", 108, 98, \\\"Next\\\", 1)\\n            }\\n        }\\n    }\\n    // B leaves the quiz and goes back to the chalkboard\\n    if (pressed == \\\"B\\\" && (quizPhase != \\\"results\\\" || elapsed() > 800)) {\\n        blip(700, 420, 80)\\n        setMode(\\\"board\\\")\\n    } else if (quizPhase == \\\"asking\\\" && pressed == \\\"left\\\" && picked > 0) {\\n        picked += -1\\n        blip(880, 880, 25)\\n    } else if (quizPhase == \\\"asking\\\" && pressed == \\\"right\\\" && picked < 2) {\\n        picked += 1\\n        blip(880, 880, 25)\\n    } else if (quizPhase == \\\"asking\\\" && pressed == \\\"A\\\") {\\n        // Check the answer (setMode restarts the screen timer for the next part)\\n        quizPhase = \\\"answered\\\"\\n        setMode(\\\"quiz\\\")\\n        if (choices[picked] == quizOrder[question]) {\\n            score += 1\\n            music.play(music.stringPlayable(\\\"E5 A5 - - - - - - \\\", 560), music.PlaybackMode.InBackground)\\n        } else {\\n            blip(230, 110, 240)\\n        }\\n    } else if (quizPhase == \\\"answered\\\" && pressed == \\\"A\\\" && elapsed() > 500) {\\n        // The short wait stops a quick double press from skipping the answer\\n        blip(660, 990, 70)\\n        question += 1\\n        if (question < 10) {\\n            newQuestion()\\n        } else {\\n            quizPhase = \\\"results\\\"\\n            setMode(\\\"quiz\\\")\\n            quizBest = Math.max(quizBest, score)\\n            music.play(music.stringPlayable(\\\"C5 E5 G5 C6 G5 C6 E6 - \\\", 420), music.PlaybackMode.InBackground)\\n        }\\n    }\\n}\\n// Open the card for a word. backTo is the screen to go back to afterwards.\\nfunction showCard (whichWord: number, cameFrom: string) {\\n    cardWord = whichWord\\n    backTo = cameFrom\\n    sayStart = -1\\n    // A word only counts the first time the player finds it\\n    cardIsNew = !(learned[whichWord])\\n    if (cardIsNew) {\\n        learned[whichWord] = true\\n        foundCount += 1\\n        music.play(music.stringPlayable(\\\"C5 E5 G5 C6 - - - - \\\", 520), music.PlaybackMode.InBackground)\\n    } else {\\n        blip(660, 990, 70)\\n    }\\n    setMode(\\\"card\\\")\\n}\\n// Add furniture. Things lower down the screen are drawn in front.\\nfunction placeProp (furniture: Image, propX: number, propBottom: number) {\\n    thing = sprites.create(furniture, SpriteKind.Decor)\\n    thing.left = propX\\n    thing.bottom = propBottom\\n    thing.z = propBottom\\n}\\n// Makes arrows and pictures float gently up and down\\nfunction bob (period: number, size: number) {\\n    return Math.round(Math.sin(game.runtime() * 6.2832 / period) * size)\\n}\\n// The chalkboard. The quiz only unlocks when all 10 words are found.\\nfunction boardScreen () {\\n    if (foundCount == 10) {\\n        canvas.drawTransparentImage(assets.image`boardOpen`, 0, 0)\\n        if (quizBest >= 0) {\\n            canvas.printText(\\\"\\\" + quizBest + \\\"/10\\\", 112, 50, 5, TextSize.Normal)\\n        }\\n    } else {\\n        canvas.drawTransparentImage(assets.image`boardLocked`, 0, 0)\\n        drawPicture(24, 76, 32 + bob(1200, 1))\\n        progressBar(30, 72, 100, 7, 5)\\n        canvas.printTextCentered(\\\"\\\" + foundCount + \\\" / 10\\\", 82, 9, TextSize.Normal)\\n    }\\n    if (pressed == \\\"A\\\" && foundCount == 10) {\\n        blip(660, 990, 70)\\n        startQuiz()\\n    } else if (pressed == \\\"A\\\") {\\n        blip(210, 160, 140)\\n    } else if (pressed == \\\"B\\\") {\\n        // Go back to where the board was opened from (the kitchen or the menu)\\n        blip(700, 420, 80)\\n        setMode(backTo)\\n    }\\n}\\n// Change to another screen and remember when it started\\nfunction setMode (newMode: string) {\\n    mode = newMode\\n    modeStart = game.runtime()\\n}\\n// A bar that fills up as the player finds more words\\nfunction progressBar (barX: number, barY: number, barW: number, barH: number, barColor: number) {\\n    panel(barX, barY, barW, barH, 15, 15)\\n    x = Math.idiv((barW - 2) * foundCount, 10)\\n    canvas.fillRect(barX + 1, barY + 1, x, barH - 2, barColor)\\n    canvas.fillRect(barX + 1, barY + 1, x, 1, 1)\\n}\\n// The word card: picture, English, the big Malay word, syllables and a tip\\nfunction cardScreen () {\\n    dim(2)\\n    canvas.drawTransparentImage(assets.image`cardFrame`, 4, 3)\\n    canvas.drawTransparentImage(bigIcons[cardWord], 12, 10)\\n    canvas.printText(wordPart(cardWord, 1), 52, 18, 8, TextSize.Normal)\\n    if (cardIsNew) {\\n        canvas.printText(\\\"NEW WORD!\\\", 52, 29, 7, TextSize.Normal)\\n    } else {\\n        canvas.printText(\\\"Learned\\\", 52, 29, 10, TextSize.Normal)\\n    }\\n    canvas.printText(\\\"\\\" + foundCount + \\\"/10 learned\\\", 52, 39, 14, TextSize.Small)\\n    drawSyllables()\\n    text = wordPart(cardWord, 3)\\n    canvas.printText(\\\"Say:\\\", 65 - 3 * text.length, 87, 10, TextSize.Normal)\\n    canvas.printText(text, 95 - 3 * text.length, 87, 12, TextSize.Normal)\\n    canvas.printTextCentered(wordPart(cardWord, 4), 97, 14, TextSize.Small)\\n    if (pressed == \\\"A\\\") {\\n        // A says the word: the syllables light up one at a time\\n        sayStart = game.runtime()\\n        lastTick = -1\\n    } else if (pressed == \\\"B\\\") {\\n        blip(700, 420, 80)\\n        setMode(backTo)\\n    }\\n}\\n// Darken the screen behind a menu or card. Each level adds a layer of dark dots.\\nfunction dim (level: number) {\\n    i = 0\\n    while (i < level) {\\n        canvas.drawTransparentImage(assets.image`darkDots`, i, i)\\n        i += 1\\n    }\\n}\\n// Corner marks around the thing that is selected\\nfunction brackets (bx: number, by: number, w: number, h: number, c: number) {\\n    canvas.drawLine(bx, by, bx + 2, by, c)\\n    canvas.drawLine(bx, by, bx, by + 2, c)\\n    canvas.drawLine(bx + w - 3, by, bx + w - 1, by, c)\\n    canvas.drawLine(bx + w - 1, by, bx + w - 1, by + 2, c)\\n    canvas.drawLine(bx, by + h - 1, bx + 2, by + h - 1, c)\\n    canvas.drawLine(bx, by + h - 3, bx, by + h - 1, c)\\n    canvas.drawLine(bx + w - 3, by + h - 1, bx + w - 1, by + h - 1, c)\\n    canvas.drawLine(bx + w - 1, by + h - 3, bx + w - 1, by + h - 1, c)\\n}\\n// Start the quiz with all 10 words in a random order\\nfunction startQuiz () {\\n    quizOrder = []\\n    i = 0\\n    while (i < 10) {\\n        // Putting each word at a random place shuffles the list\\n        quizOrder.insertAt(randint(0, quizOrder.length), i)\\n        i += 1\\n    }\\n    question = 0\\n    score = 0\\n    newQuestion()\\n    setMode(\\\"quiz\\\")\\n}\\n// Add an invisible box over something the player can use (wordNumber -1 fridge, -2 cupboard, -3 chalkboard)\\nfunction addSpot (spotX: number, spotY: number, spotW: number, spotH: number, wordNumber: number) {\\n    thing = sprites.create(image.create(spotW, spotH), SpriteKind.Decor)\\n    thing.setFlag(SpriteFlag.Invisible, true)\\n    thing.left = spotX\\n    thing.top = spotY\\n    spots.push(thing)\\n    spotWord.push(wordNumber)\\n}\\n// The open fridge or cupboard. The egg (word 8) is in the fridge and the bread (word 9) in the cupboard.\\nfunction containerScreen () {\\n    n = 9\\n    x = 72\\n    y = 30\\n    canvas.drawTransparentImage(assets.image`bgCupboard`, 0, 0)\\n    if (inFridge) {\\n        n = 8\\n        x = 26\\n        y = 47\\n        canvas.drawTransparentImage(assets.image`bgFridge`, 0, 0)\\n    }\\n    brackets(x - 3, y - 3, 22, 22, 5 - Math.idiv(game.runtime() % 600, 300))\\n    drawPicture(n, x, y + bob(800, 1))\\n    drawPicture(23, x + 4, y - 10 + bob(600, 1))\\n    if (learned[n]) {\\n        drawPicture(25, x + 10, y + 11)\\n        canvas.printTextCentered(\\\"\\\" + wordPart(n, 0) + \\\" (\\\" + wordPart(n, 1) + \\\")\\\", 99, 5, TextSize.Normal)\\n    } else {\\n        canvas.printTextCentered(\\\"??? - a new word!\\\", 99, 6, TextSize.Normal)\\n    }\\n    if (pressed == \\\"A\\\") {\\n        showCard(n, \\\"container\\\")\\n    } else if (pressed == \\\"B\\\") {\\n        blip(620, 240, 130)\\n        setMode(\\\"explore\\\")\\n    }\\n}\\n// The kitchen: the word counter and a highlight on the thing in front of the player\\nfunction exploreScreen () {\\n    // Find the thing just in front of the player's feet (-1 means nothing), with 3 pixels to spare\\n    focus = -1\\n    x = hero.x + dirX[facing] * 11\\n    y = hero.y + dirY[facing] * 11\\n    j = 3 * Math.abs(dirX[facing])\\n    k = 3 * Math.abs(dirY[facing])\\n    i = 0\\n    while (i < spots.length) {\\n        thing = spots[i]\\n        if (x >= thing.left - j && x <= thing.right + j && y >= thing.top - k && y <= thing.bottom + k) {\\n            focus = i\\n        }\\n        i += 1\\n    }\\n    canvas.drawTransparentImage(assets.image`hudBar`, 0, 0)\\n    canvas.printText(\\\"\\\" + foundCount + \\\"/10\\\", 17, 5, 1, TextSize.Normal)\\n    progressBar(50, 6, 21, 5, 7)\\n    if (focus >= 0) {\\n        thing = spots[focus]\\n        n = spotWord[focus]\\n        j = thing.left - camLeft - 2\\n        k = thing.top - camTop - 2\\n        brackets(j, k, thing.width + 4, thing.height + 4, 5 - 4 * Math.idiv(game.runtime() % 700, 350))\\n        // At the bottom, show what A will do here\\n        text = \\\"Look\\\"\\n        if (n < 0) {\\n            text = \\\"Open fridge|Open cupboard|Challenge\\\".split(\\\"|\\\")[0 - n - 1]\\n        } else if (learned[n]) {\\n            text = wordPart(n, 0)\\n        }\\n        panel(70 - 3 * text.length, 104, 20 + 6 * text.length, 14, 8, 15)\\n        hint(\\\"A\\\", 74 - 3 * text.length, 106, text, 1)\\n        if (pressed == \\\"A\\\" && n >= 0) {\\n            showCard(n, \\\"explore\\\")\\n        } else if (pressed == \\\"A\\\" && n == -3) {\\n            backTo = \\\"explore\\\"\\n            blip(260, 720, 160)\\n            setMode(\\\"board\\\")\\n        } else if (pressed == \\\"A\\\") {\\n            inFridge = n == -1\\n            blip(260, 720, 160)\\n            setMode(\\\"container\\\")\\n            // The first time the fridge opens, teach the word for it (word 7)\\n            if (inFridge && !(learned[7])) {\\n                showCard(7, \\\"container\\\")\\n            }\\n        }\\n    }\\n    if (pressed == \\\"B\\\") {\\n        menuChoice = 0\\n        blip(260, 720, 160)\\n        setMode(\\\"menu\\\")\\n    }\\n}\\n// Get part of a word: 0 Malay, 1 English, 2 syllables, 3 how to say it, 4 tip, 5 where it is\\nfunction wordPart (word: number, part: number) {\\n    return words[word].split(\\\"|\\\")[part]\\n}\\n// Draw one 16x16 picture from the picture strip: 0-9 the words, 10-19 their grey shapes,\\n// 20 A button, 21 B button, 22 arrow right, 23 arrow down, 24 lock, 25 tick\\nfunction drawPicture (which: number, picX: number, picY: number) {\\n    picture.fill(0)\\n    picture.drawTransparentImage(assets.image`pictureStrip`, -16 * which, 0)\\n    canvas.drawTransparentImage(picture, picX, picY)\\n}\\n// Move the player with the arrow keys and pick the walking picture\\nfunction updateHero () {\\n    // k is the arrow held: 0 up, 1 right, 2 down, 3 left (-1 means none)\\n    k = -1\\n    if (controller.up.isPressed()) {\\n        k = 0\\n    } else if (controller.down.isPressed()) {\\n        k = 2\\n    } else if (controller.left.isPressed()) {\\n        k = 3\\n    } else if (controller.right.isPressed()) {\\n        k = 1\\n    }\\n    // A new arrow press also counts as a press for the menus\\n    if (k >= 0 && k != lastArrow) {\\n        pressed = \\\"up|right|down|left\\\".split(\\\"|\\\")[k]\\n    }\\n    lastArrow = k\\n    // A wall stops the player. While moving, the pictures go step, stand, other step, stand.\\n    j = 0\\n    if (hero.vx != 0 || hero.vy != 0) {\\n        j = parseFloat(\\\"1020\\\".charAt(Math.idiv(game.runtime(), 130) % 4))\\n    }\\n    hero.vx = 0\\n    hero.vy = 0\\n    if (k >= 0 && mode == \\\"explore\\\") {\\n        facing = k\\n        hero.vx = dirX[k] * 72\\n        hero.vy = dirY[k] * 72\\n    }\\n    // Cut the picture out of the hero sheet (rows: up, right, down, left)\\n    heroPic.fill(0)\\n    heroPic.drawTransparentImage(assets.image`heroSheet`, -16 * j, -16 * facing)\\n    heroLook.x = hero.x\\n    heroLook.bottom = hero.bottom + 1\\n    heroLook.z = hero.bottom\\n    // Where the camera will be, so the highlights line up with the kitchen\\n    camLeft = Math.max(0, Math.min(160, Math.floor(heroLook.left - 72)))\\n    camTop = Math.max(0, Math.min(72, Math.floor(heroLook.top - 52)))\\n}\\nlet lastArrow = 0\\nlet camTop = 0\\nlet camLeft = 0\\nlet facing = 0\\nlet focus = 0\\nlet inFridge = false\\nlet spotWord: number[] = []\\nlet spots: Sprite[] = []\\nlet mode = \\\"\\\"\\nlet cardIsNew = false\\nlet score = 0\\nlet lastTick = 0\\nlet y = 0\\nlet x = 0\\nlet n = 0\\nlet cardWord = 0\\nlet syllables = \\\"\\\"\\nlet sayStart = 0\\nlet lit = 0\\nlet quizPhase = \\\"\\\"\\nlet picked = 0\\nlet question = 0\\nlet quizOrder: number[] = []\\nlet choices: number[] = []\\nlet j = 0\\nlet foundCount = 0\\nlet bookChoice = 0\\nlet backTo = \\\"\\\"\\nlet text = \\\"\\\"\\nlet menuChoice = 0\\nlet k = 0\\nlet pressed = \\\"\\\"\\nlet modeStart = 0\\nlet learned: boolean[] = []\\nlet bigIcons: Image[] = []\\nlet i = 0\\nlet heroLook: Sprite = null\\nlet heroPic: Image = null\\nlet hero: Sprite = null\\nlet quizBest = 0\\nlet dirY: number[] = []\\nlet dirX: number[] = []\\nlet words: string[] = []\\nlet picture: Image = null\\nlet thing: Sprite = null\\nlet canvas: Image = null\\n// Kitchen Language Game: find 10 things in the kitchen, learn their Malay names, then take the quiz\\n// Menus, cards and text are drawn on this see-through picture, which covers the screen.\\ncanvas = image.create(160, 120)\\nthing = sprites.create(canvas, SpriteKind.Decor)\\nthing.setFlag(SpriteFlag.RelativeToCamera, true)\\nthing.z = 1000\\npicture = image.create(16, 16)\\n// The 10 words. Each one is: Malay | English | syllables | how to say it | tip | where to find it\\nwords = [\\n\\\"Kuali|Pan|ku-a-li|koo-ah-lee|Said fast: 'kwah-lee'|On the stove\\\",\\n\\\"Pinggan|Plate|ping-gan|ping-gahn|ngg as in 'finger'|In the dish rack\\\",\\n\\\"Sudu|Spoon|su-du|soo-doo||On the dining table\\\",\\n\\\"Garpu|Fork|gar-pu|gar-poo|Tap the r lightly|On the dining table\\\",\\n\\\"Pisau|Knife|pi-sau|pee-sow|au rhymes with 'cow'|On the kitchen island\\\",\\n\\\"Cawan|Cup|ca-wan|chah-wahn|c sounds like 'ch'|On the wall shelf\\\",\\n\\\"Periuk|Pot|pe-ri-uk|puh-ree-oo(k)|(k) = the stop in uh-oh|On the stove\\\",\\n\\\"Peti sejuk|Refrigerator|pe-ti se-juk|puh-tee suh-joo(k)|(k) = the stop in uh-oh|Top-left corner\\\",\\n\\\"Telur|Egg|te-lur|tuh-loor|e sounds like 'uh'|Inside the fridge\\\",\\n\\\"Roti|Bread|ro-ti|roh-tee||Inside the cupboard\\\"\\n]\\n// How far one step goes in x and y for each direction: up, right, down, left\\ndirX = [\\n0,\\n1,\\n0,\\n-1\\n]\\ndirY = [\\n-1,\\n0,\\n1,\\n0\\n]\\n// -1 means the quiz has not been finished yet\\nquizBest = -1\\n// The kitchen map and the furniture in it. The title shows the middle of the kitchen.\\ntiles.setCurrentTilemap(tilemap`kitchen`)\\nscene.centerCameraAt(160, 96)\\nplaceProp(assets.image`islandAndChairs`, 80, 112)\\nplaceProp(assets.image`tableAndShelf`, 16, 128)\\nplaceProp(assets.image`frontPlants`, 16, 176)\\n// Things the player can use: fridge, plate, pan, pot, cupboard, cup, chalkboard, knife, spoon, fork\\naddSpot(16, 16, 32, 32, -1)\\naddSpot(112, 22, 16, 24, 1)\\naddSpot(126, 26, 18, 20, 0)\\naddSpot(144, 22, 16, 24, 6)\\naddSpot(176, 16, 32, 32, -2)\\naddSpot(224, 16, 16, 10, 5)\\naddSpot(272, 16, 16, 12, -3)\\naddSpot(96, 90, 16, 16, 4)\\naddSpot(208, 104, 16, 15, 2)\\naddSpot(240, 104, 16, 15, 3)\\n// The player is an invisible box at the feet that bumps into walls. heroLook is drawn on top.\\nlet icon = image.create(10, 6)\\nicon.fill(2)\\nhero = sprites.create(icon, SpriteKind.Player)\\nhero.setFlag(SpriteFlag.Invisible, true)\\nhero.setPosition(160, 154)\\nheroPic = image.create(16, 16)\\nheroLook = sprites.create(heroPic, SpriteKind.Decor)\\nheroLook.setFlag(SpriteFlag.Invisible, true)\\n// Cut the big word pictures out of their strip. No words have been found yet.\\ni = 0\\nwhile (i < 10) {\\n    icon = image.create(32, 32)\\n    icon.drawTransparentImage(assets.image`bigWordIcons`, -32 * i, 0)\\n    bigIcons.push(icon)\\n    learned.push(false)\\n    i += 1\\n}\\nsetMode(\\\"title\\\")\\n// Every frame: move the player, then draw the screen that is showing\\ngame.onUpdate(function () {\\n    updateHero()\\n    // Ignore a press that happened just as the screen changed, so it does not count twice\\n    if (elapsed() < 150) {\\n        pressed = \\\"\\\"\\n    }\\n    canvas.fill(0)\\n    if (mode == \\\"title\\\") {\\n        titleScreen()\\n    } else if (mode == \\\"help\\\") {\\n        helpScreen()\\n    } else if (mode == \\\"explore\\\") {\\n        exploreScreen()\\n    } else if (mode == \\\"card\\\") {\\n        cardScreen()\\n    } else if (mode == \\\"container\\\") {\\n        containerScreen()\\n    } else if (mode == \\\"menu\\\") {\\n        menuScreen()\\n    } else if (mode == \\\"book\\\") {\\n        bookScreen()\\n    } else if (mode == \\\"board\\\") {\\n        boardScreen()\\n    } else {\\n        quizScreen()\\n    }\\n    pressed = \\\"\\\"\\n})\\n\",\n  \"custom.ts\": \"// Custom blocks for writing text on a picture, because MakeCode Arcade has no block for it\\nenum TextSize {\\n    Small,\\n    Normal,\\n    Big\\n}\\nnamespace helpers {\\n    function kitchenFont(size: TextSize): image.Font {\\n        if (size == TextSize.Small) return image.font5\\n        if (size == TextSize.Big) return image.scaledFont(image.font8, 2)\\n        return image.font8\\n    }\\n    export function kitchenPrintText(target: Image, text: string, x: number, y: number, color: number, size: TextSize) {\\n        target.print(text, x, y, color, kitchenFont(size))\\n    }\\n    // Put the text in the middle of the picture\\n    export function kitchenPrintTextCentered(target: Image, text: string, y: number, color: number, size: TextSize) {\\n        const font = kitchenFont(size)\\n        target.print(text, Math.idiv(target.width - text.length * font.charWidth, 2), y, color, font)\\n    }\\n}\\ninterface Image {\\n    //% helper=kitchenPrintText blockNamespace=images group=\\\"Text\\\" weight=30\\n    //% block=\\\"$this print $text at x $x y $y color $color size $size\\\"\\n    //% this.shadow=variables_get this.defl=canvas color.shadow=colorindexpicker inlineInputMode=inline\\n    printText(text: string, x: number, y: number, color: number, size: TextSize): void;\\n    //% helper=kitchenPrintTextCentered blockNamespace=images group=\\\"Text\\\" weight=20\\n    //% block=\\\"$this print $text centered at y $y color $color size $size\\\"\\n    //% this.shadow=variables_get this.defl=canvas color.shadow=colorindexpicker inlineInputMode=inline\\n    printTextCentered(text: string, y: number, color: number, size: TextSize): void;\\n}\\n\",\n  \"images.g.jres\": \"{\\n    \\\"image17\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"bigWordIcons\\\"\\n    },\\n    \\\"image3\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"frontPlants\\\"\\n    },\\n    \\\"image2\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"tableAndShelf\\\"\\n    },\\n    \\\"image1\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"islandAndChairs\\\"\\n    },\\n    \\\"image19\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"pictureStrip\\\"\\n    },\\n    \\\"image4\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"darkDots\\\"\\n    },\\n    \\\"image18\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"heroSheet\\\"\\n    },\\n    \\\"image5\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"hudBar\\\"\\n    },\\n    \\\"image6\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"titleArt\\\"\\n    },\\n    \\\"image7\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"helpCard\\\"\\n    },\\n    \\\"image8\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"cardFrame\\\"\\n    },\\n    \\\"image9\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"bookFrame\\\"\\n    },\\n    \\\"image11\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"boardOpen\\\"\\n    },\\n    \\\"image10\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"boardLocked\\\"\\n    },\\n    \\\"image13\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"bgCupboard\\\"\\n    },\\n    \\\"image12\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"bgFridge\\\"\\n    },\\n    \\\"image14\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"bgQuiz\\\"\\n    },\\n    \\\"image16\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"quizResults\\\"\\n    },\\n    \\\"image15\\\": {\\n        \\\"data\\\": \\\"\\\",\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"displayName\\\": \\\"quizCard\\\"\\n    },\\n    \\\"*\\\": {\\n        \\\"mimeType\\\": \\\"image/x-mkcd-f4\\\",\\n        \\\"dataEncoding\\\": \\\"base64\\\",\\n        \\\"namespace\\\": \\\"myImages\\\"\\n    }\\n}\",\n  \"images.g.ts\": \"// Auto-generated code. Do not edit.\\nnamespace myImages {\\n\\n    helpers._registerFactory(\\\"image\\\", function(name: string) {\\n        switch(helpers.stringTrim(name)) {\\n            case \\\"image17\\\":\\n            case \\\"bigWordIcons\\\":return img`\\n....................................................................ffffff........................ff..ff..ff........................ffffff............................ff11ffff11ff....................................................ffffffffffffffffffff......................................................................\\n....................................................................ffffff........................ff..ff..ff........................ffffff............................ff11ffff11ff....................................................ffffffffffffffffffff......................................................................\\n..................................................................ff999999ff....................ff99ff99ff99ff....................ff119999ff............................ff11ffff11ff................................................ff11111111111111119999ff....................................................................\\n..................................................................ff999999ff....................ff99ff99ff99ff....................ff119999ff............................ff11ffff11ff................................................ff11111111111111119999ff....................................................................\\n................................................................ff9911111199ff..................ff99ff99ff99ff......................ff119999ff........................ff11ffff11ff............................ffff..................ff11111111111111aa9999ff..........................................ffffffffffffffff..........\\n................................................................ff9911111199ff..................ff99ff99ff99ff......................ff119999ff........................ff11ffff11ff............................ffff..................ff11111111111111aa9999ff..........................................ffffffffffffffff..........\\n................................................................ff9911119999ff..................ff99ff99ff99ff........................ff119999ff....................ffffffffffffffff................ffffffffffffffffffffffff........ff11111111111111aa9999ff..............ff........................ffddddddddddddddddffff......\\n................................................................ff9911119999ff..................ff99ff99ff99ff........................ff119999ff....................ffffffffffffffff................ffffffffffffffffffffffff........ff11111111111111aa9999ff..............ff........................ffddddddddddddddddffff......\\n..........................ffff........ffffffffffffffffffff......ff99999999ff....................ff9999999999ff..........................ff119999ff................ff1122222222222222ffffff........ffaa99991111111111119999aaff......ff11111111111111aa9999ff..........ffff11ffff..................ffdddd1111ddddddddddddddff....\\n..........................ffff........ffffffffffffffffffff......ff99999999ff....................ff9999999999ff..........................ff119999ff................ff1122222222222222ffffff........ffaa99991111111111119999aaff......ff11111111111111aa9999ff..........ffff11ffff..................ffdddd1111ddddddddddddddff....\\n........ffffffffffff....ffccccff....ff66666666666666666666ff......ff99ffaaffff....................ff999999aaff............................ff119999ff..............ff1122222222222222222222ff....ffaaaa99999999999999999999aaaaff....ffaaaaaaaaaaaaaaaaaaaaff........ff1111111111ffffffffff......ffddddddddddddddddddddddddddff..\\n........ffffffffffff....ffccccff....ff6666666666666666666